#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
work_dir=$(mktemp -d)
trap 'rm -rf -- "$work_dir"' EXIT

tofu -chdir="$repo_root/opentofu" fmt -check -recursive
for root in "$repo_root"/opentofu/environments/*; do
  export TF_DATA_DIR="$work_dir/$(basename -- "$root")"
  tofu -chdir="$root" init -backend=false -input=false -lockfile=readonly
  tofu -chdir="$root" validate
done
