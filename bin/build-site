#!/usr/bin/env python3
"""Build both static sites without installing project dependencies."""

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))

from canones_weather.site import build_site  # noqa: E402

build_site(ROOT, ROOT / "dist")
print("Built dist/hub and dist/canones")
