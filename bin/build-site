#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

for name in hub canones; do
  rm -rf -- "dist/$name"
  mkdir -p "dist/$name"
  cp -R "site/$name/." "dist/$name/"
  cp -R site/shared/assets "dist/$name/"
  cp site/shared/_headers "dist/$name/"
done
printf 'Built dist/hub and dist/canones\n'
