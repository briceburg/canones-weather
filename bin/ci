#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

uv run --locked ruff check
uv run --locked ruff format --check
uv run --locked --group station pytest -q
for source in site/shared/assets/*.js; do
  node --input-type=module --check < "$source"
done
bin/build-site
bin/check-infra
