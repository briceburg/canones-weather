#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

python_scripts=(bin/build-site bin/generate-sample bin/create-release)
uv run --locked ruff check . "${python_scripts[@]}"
uv run --locked ruff format --check . "${python_scripts[@]}"
uv run --locked --group station pytest -q
for source in site/shared/assets/*.js; do
  node --input-type=module --check < "$source"
done
bin/build-site
node --test tests/test_*.mjs
bin/check-infra
