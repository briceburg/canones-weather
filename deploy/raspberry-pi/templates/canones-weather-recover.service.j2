[Unit]
Description=Recover missing Canones pilot archive intervals from gateway SD logs
Wants=network-online.target
After=network-online.target canones-weather-pilot.service

[Service]
Type=oneshot
User=canones-weather
Group=canones-weather
Environment=TZ={{ weather_station.timezone }}
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart={{ weather_install_root }}/.venv/bin/python -m canones_weather.recover {{ weather_state_root }}/weewx.conf
TimeoutStartSec=180
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ weather_state_root }}
UMask=0027
