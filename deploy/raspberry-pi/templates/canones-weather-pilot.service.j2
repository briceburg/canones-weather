[Unit]
Description=Canones weather pilot collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=canones-weather
Group=canones-weather
Environment=TZ=America/Denver
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart={{ weather_install_root }}/.venv/bin/weewxd {{ weather_state_root }}/weewx.conf
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ weather_state_root }}
UMask=0027

[Install]
WantedBy=multi-user.target
