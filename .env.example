# Local configuration. Copy to .env and fill in values from your network.
# Gateway: HTTP(S) origin. Pi: SSH target in user@host form.
WEATHER_GATEWAY_URL=
WEATHER_PI_SSH=
# Ground elevation in metres above sea level, separate from pole height.
WEATHER_ELEVATION_M=
# Set to 1 to enable automatic SD recovery for the pilot.
WEATHER_SD_RECOVERY=0
